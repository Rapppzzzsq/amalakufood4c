generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admin {
  id_admin     String   @id @db.VarChar(10)
  id_pengguna  String   @unique @db.VarChar(10)
  nama_admin   String   @db.VarChar(100)
  no_handphone String   @db.VarChar(15)
  email_admin  String   @db.VarChar(100)
  pengguna     pengguna @relation(fields: [id_pengguna], references: [id_pengguna])
  produk       produk[]
}

model alamat {
  kode_pos  String     @id @db.VarChar(10)
  jalan     String     @db.VarChar(100)
  no_jalan  String     @db.VarChar(10)
  kelurahan String     @db.VarChar(50)
  kecamatan String     @db.VarChar(50)
  kota      String     @db.VarChar(50)
  customer  customer[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customer {
  id_customer    String      @id @db.VarChar(10)
  id_pengguna    String      @unique @db.VarChar(10)
  nama_customer  String      @db.VarChar(100)
  no_handphone   String      @db.VarChar(15)
  jalan          String?     @db.VarChar(100)
  no_jalan       String?     @db.VarChar(10)
  kelurahan      String?     @db.VarChar(50)
  kecamatan      String?     @db.VarChar(50)
  kota           String?     @default("Padang") @db.VarChar(50)
  kode_pos       String?     @db.VarChar(10)
  email_customer String      @db.VarChar(100)
  poin           Int         @default(0)
  pengguna       pengguna    @relation(fields: [id_pengguna], references: [id_pengguna])
  alamat         alamat?     @relation(fields: [kode_pos], references: [kode_pos])
  pesanan        pesanan[]
  registrasi     registrasi?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detail_pesanan {
  id_detail_pesanan String  @id @db.VarChar(10)
  id_pesanan        String  @db.VarChar(10)
  id_produk         String  @db.VarChar(10)
  jumlah            Int
  harga_satuan      Decimal @db.Decimal(12, 2)
  subtotal          Decimal @db.Decimal(12, 2)
  pesanan           pesanan @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: Cascade)
  produk            produk  @relation(fields: [id_produk], references: [id_produk])
}

model kasir {
  id_kasir      String          @id @db.VarChar(10)
  id_pengguna   String          @unique @db.VarChar(10)
  nama_kasir    String          @db.VarChar(100)
  no_handphone  String          @db.VarChar(15)
  email_kasir   String          @db.VarChar(100)
  pengguna      pengguna        @relation(fields: [id_pengguna], references: [id_pengguna])
  laporan_kasir laporan_kasir[]
  pesanan       pesanan[]
}

model laporan_akhir {
  id_laporan_akhir String        @id @db.VarChar(15)
  id_laporan_owner String        @db.VarChar(15)
  tanggal_final    DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  total_penjualan  Decimal       @default(0) @db.Decimal(14, 2)
  jumlah_transaksi Int           @default(0)
  laporan_owner    laporan_owner @relation(fields: [id_laporan_owner], references: [id_laporan_owner], onDelete: Cascade)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model laporan_kasir {
  id_laporan_kasir String          @id @db.VarChar(15)
  id_kasir         String          @db.VarChar(10)
  periode_awal     DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  periode_akhir    DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  bulan_laporan    String?         @default("Oktober 2026") @db.VarChar(30)
  jenis_laporan    String          @db.VarChar(20)
  jumlah_produk    Int?            @default(0)
  total_stok       Int?            @default(0)
  jumlah_transaksi Int?            @default(0)
  total_penjualan  Decimal         @default(0) @db.Decimal(14, 2)
  status_penjualan String          @default("Menunggu Pemeriksaan") @db.VarChar(30)
  kasir            kasir           @relation(fields: [id_kasir], references: [id_kasir])
  laporan_owner    laporan_owner[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model laporan_owner {
  id_laporan_owner   String          @id @db.VarChar(15)
  id_owner           String          @db.VarChar(10)
  id_laporan_kasir   String          @db.VarChar(15)
  tanggal_periksa    DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  catatan_evaluasi   String          @db.VarChar(255)
  status_persetujuan String          @default("Disetujui") @db.VarChar(20)
  laporan_akhir      laporan_akhir[]
  laporan_kasir      laporan_kasir   @relation(fields: [id_laporan_kasir], references: [id_laporan_kasir], onDelete: Cascade)
  owner              owner           @relation(fields: [id_owner], references: [id_owner])
}

model nota {
  id_nota       String     @id @db.VarChar(10)
  id_pembayaran String     @unique @db.VarChar(10)
  no_nota       String     @unique @db.VarChar(20)
  tanggal_cetak DateTime   @default(dbgenerated("CURRENT_DATE")) @db.Date
  pembayaran    pembayaran @relation(fields: [id_pembayaran], references: [id_pembayaran], onDelete: Cascade)
}

model owner {
  id_owner      String          @id @db.VarChar(10)
  id_pengguna   String          @unique @db.VarChar(10)
  nama_owner    String          @db.VarChar(100)
  no_handphone  String          @db.VarChar(15)
  email_owner   String          @db.VarChar(100)
  laporan_owner laporan_owner[]
  pengguna      pengguna        @relation(fields: [id_pengguna], references: [id_pengguna])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pembayaran {
  id_pembayaran      String   @id @db.VarChar(10)
  id_pesanan         String   @unique @db.VarChar(10)
  metode_pembayaran  String   @db.VarChar(30)
  nominal_pembayaran Decimal  @db.Decimal(12, 2)
  tanggal_bayar      DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  status_pembayaran  String   @default("Menunggu") @db.VarChar(30)
  nota               nota?
  pesanan            pesanan  @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: Cascade)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pengguna {
  id_pengguna String    @id @db.VarChar(10)
  username    String    @unique @db.VarChar(50)
  password    String    @db.VarChar(100)
  role        String    @db.VarChar(20)
  admin       admin?
  customer    customer?
  kasir       kasir?
  owner       owner?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pesanan {
  id_pesanan      String           @id @db.VarChar(10)
  id_customer     String           @db.VarChar(10)
  id_kasir        String?          @db.VarChar(10)
  tanggal_pesanan DateTime         @default(dbgenerated("CURRENT_DATE")) @db.Date
  status_pesanan  String           @default("Diproses") @db.VarChar(30)
  total_tagihan   Decimal          @default(0) @db.Decimal(12, 2)
  detail_pesanan  detail_pesanan[]
  pembayaran      pembayaran?
  customer        customer         @relation(fields: [id_customer], references: [id_customer], onDelete: Cascade)
  kasir           kasir?           @relation(fields: [id_kasir], references: [id_kasir])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model produk {
  id_produk      String           @id @db.VarChar(10)
  id_admin       String           @db.VarChar(10)
  nama_produk    String           @db.VarChar(100)
  kategori       String           @db.VarChar(50)
  harga          Decimal          @db.Decimal(12, 2)
  stok           Int              @default(0)
  deskripsi      String?
  detail_pesanan detail_pesanan[]
  admin          admin            @relation(fields: [id_admin], references: [id_admin])
}

model registrasi {
  id_registrasi      String   @id @db.VarChar(10)
  id_customer        String   @unique @db.VarChar(10)
  tanggal_registrasi DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  status_registrasi  String   @default("Aktif") @db.VarChar(20)
  customer           customer @relation(fields: [id_customer], references: [id_customer], onDelete: Cascade)
}
